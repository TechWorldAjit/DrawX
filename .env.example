# DrawX Environment Variables Configuration
# Copy this file to .env for local development

# 1. MongoDB Atlas Connection String
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers (Node.js)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DBNAME=drawx

# 2. JWT Secret Key
# Generate any long, random string (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# 3. Local Backend Port (Default: 5001)
PORT=5001

# 4. Google Gemini API Key
# Get this from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Instructions for Vercel Deployment:
# 1. In your Vercel Project Settings -> Environment Variables, add:
#    - MONGO_URI
#    - MONGODB_DBNAME (optional, defaults to drawx)
#    - JWT_SECRET
#    - GEMINI_API_KEY
# 2. Redeploy the project on Vercel after saving environment variables.
